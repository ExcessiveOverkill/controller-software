{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Remote Debug on Zynq",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/zynq_files/controller/bin/controller_core",
            "args": [],
            "stopAtEntry": false,   // stop at main?
            "targetArchitecture": "arm",
            "cwd": "${workspaceFolder}/build",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb-multiarch", // Ensure gdb-multiarch is installed in WSL
            "additionalSOLibSearchPath": "${workspaceFolder}/.debug/zynq-sysroot/lib;${workspaceFolder}/.debug/zynq-sysroot/lib/arm-linux-gnueabihf;${workspaceFolder}/.debug/zynq-sysroot/usr/lib;${workspaceFolder}/.debug/zynq-sysroot/usr/lib/arm-linux-gnueabihf;${workspaceFolder}/.debug/zynq-sysroot/usr/local/lib",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Use the cached Zynq sysroot for absolute shared-library paths",
                    "text": "set sysroot ${workspaceFolder}/.debug/zynq-sysroot",
                    "ignoreFailures": true
                },
                {
                    "description": "Resolve absolute shared-library paths inside the cached Zynq sysroot",
                    "text": "set solib-absolute-prefix ${workspaceFolder}/.debug/zynq-sysroot",
                    "ignoreFailures": true
                },
                {
                    "description": "Prefer downloaded Zynq shared libraries when symbols are loaded",
                    "text": "set solib-search-path ${workspaceFolder}/.debug/zynq-sysroot/lib:${workspaceFolder}/.debug/zynq-sysroot/lib/arm-linux-gnueabihf:${workspaceFolder}/.debug/zynq-sysroot/usr/lib:${workspaceFolder}/.debug/zynq-sysroot/usr/lib/arm-linux-gnueabihf:${workspaceFolder}/.debug/zynq-sysroot/usr/local/lib",
                    "ignoreFailures": true
                },
                {
                    "description": "Use cached Zynq split debug symbols when available",
                    "text": "set debug-file-directory ${workspaceFolder}/.debug/zynq-sysroot/lib/.debug:${workspaceFolder}/.debug/zynq-sysroot/lib/debug:${workspaceFolder}/.debug/zynq-sysroot/usr/lib/.debug:${workspaceFolder}/.debug/zynq-sysroot/usr/lib/debug:${workspaceFolder}/.debug/zynq-sysroot/usr/local/lib/.debug:${workspaceFolder}/.debug/zynq-sysroot/usr/local/lib/debug",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "Launch gdbserver on Zynq",
            "miDebuggerServerAddress": "192.168.1.243:1234", // Replace with your SSH alias and port
            "sourceFileMap": {
                "/home/em-os/controller/": "${workspaceFolder}/zynq_files/controller/" // Adjust if your source files are in a different location
            },
            "logging": {
                "trace": true,
                "traceResponse": true,
                "engineLogging": true
            }
        }
    ]
}
